generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "cjs"
}
datasource db {
  provider = "postgresql"
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  username String @db.VarChar(20)
  usernameKey String @unique @db.VarChar(20)
  passwordHash String
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  sessions AuthSession[]
  hostedRooms Room[] @relation("RoomHost")
  joinedRooms Room[] @relation("RoomChallenger")
  sentInvitations Invitation[] @relation("InvitationSender")
  receivedInvitations Invitation[] @relation("InvitationRecipient")
  notifications Notification[] @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")
  emailJobs EmailJob[]
  gameSeats GameParticipant[]
  gameMoves GameMove[]
  gameCommands GameCommand[]
  matchmaking MatchmakingSearch?
  passwordResetTokens PasswordResetToken[]
  ratings PlayerRating[]
  ratingChanges RatingChange[] @relation("RatingPlayer")
  opponentRatingChanges RatingChange[] @relation("RatingOpponent")
  socialRevision Int @default(0)
  sentFriendRequests FriendRequest[] @relation("FriendRequestSender")
  receivedFriendRequests FriendRequest[] @relation("FriendRequestRecipient")
  friendshipsLow Friendship[] @relation("FriendshipLow")
  friendshipsHigh Friendship[] @relation("FriendshipHigh")
  blocks UserBlock[] @relation("Blocker")
  blockedBy UserBlock[] @relation("Blocked")
}
model AuthSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  persistent Boolean @default(false)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  tokens RefreshToken[]
  @@index([userId, revokedAt])
  @@index([expiresAt])
}
model RefreshToken {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  session AuthSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.Char(64)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  usedAt DateTime? @db.Timestamptz(3)
  @@index([sessionId])
}
/// Single-use password reset credential. Only the SHA-256 digest of the emailed token is stored.
model PasswordResetToken {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String @unique @db.Char(64)
  /// The raw token sealed with AES-256-GCM for the outbox worker; cleared once the email settles or the token ends.
  mailPayload String? @db.VarChar(200)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  revokedAt DateTime? @db.Timestamptz(3)
  emailJobs EmailJob[]
  @@index([userId, createdAt])
  @@index([expiresAt])
}

enum RoomStatus {
  WAITING
  READY
  /// A game was created from the room; seats and settings are final.
  STARTED
  CANCELLED
  EXPIRED
}
enum ColorPreference {
  WHITE
  BLACK
  RANDOM
}
/// Private two-seat room. Seats live on the row so one row lock serializes seat claims.
model Room {
  id String @id @default(uuid()) @db.Uuid
  hostId String @db.Uuid
  host User @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  challengerId String? @db.Uuid
  challenger User? @relation("RoomChallenger", fields: [challengerId], references: [id], onDelete: SetNull)
  status RoomStatus @default(WAITING)
  /// Increases on every persisted change; clients send it back with mutations.
  revision Int @default(1)
  initialMs Int
  incrementMs Int
  colorPreference ColorPreference @default(RANDOM)
  hostReady Boolean @default(false)
  challengerReady Boolean @default(false)
  expiresAt DateTime @db.Timestamptz(3)
  closedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  invitations Invitation[]
  notifications Notification[]
  game Game?
  @@index([hostId, status])
  @@index([challengerId, status])
  @@index([status, expiresAt])
}
enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}
enum InvitationAddress {
  USERNAME
  EMAIL
}
model Invitation {
  id String @id @default(uuid()) @db.Uuid
  roomId String @db.Uuid
  room Room @relation(fields: [roomId], references: [id], onDelete: Cascade)
  senderId String @db.Uuid
  sender User @relation("InvitationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String @db.Uuid
  recipient User @relation("InvitationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// How the sender addressed the recipient; username invitations never reveal the recipient's email.
  addressedBy InvitationAddress
  status InvitationStatus @default(PENDING)
  expiresAt DateTime @db.Timestamptz(3)
  respondedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  notifications Notification[]
  emailJobs EmailJob[]
  @@index([recipientId, status, createdAt])
  @@index([senderId, createdAt])
  @@index([roomId, status])
  @@index([status, expiresAt])
}
enum NotificationType {
  INVITATION_RECEIVED
  INVITATION_ACCEPTED
  INVITATION_DECLINED
  FRIEND_REQUEST_RECEIVED
  FRIEND_REQUEST_ACCEPTED
}
/// Durable inbox entry, separate from invitation state; reading it never answers the invitation.
model Notification {
  id String @id @default(uuid()) @db.Uuid
  recipientId String @db.Uuid
  recipient User @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actorId String? @db.Uuid
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  type NotificationType
  invitationId String? @db.Uuid
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  roomId String? @db.Uuid
  room Room? @relation(fields: [roomId], references: [id], onDelete: Cascade)
  friendRequestId String? @db.Uuid
  friendRequest FriendRequest? @relation(fields: [friendRequestId], references: [id], onDelete: Cascade)
  /// One entry per logical event, so retried writes cannot duplicate inbox items.
  dedupeKey String @unique @db.VarChar(120)
  readAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@index([recipientId, createdAt(sort: Desc), id(sort: Desc)])
}

enum FriendRequestState {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

model FriendRequest {
  id String @id @default(uuid()) @db.Uuid
  senderId String @db.Uuid
  sender User @relation("FriendRequestSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String @db.Uuid
  recipient User @relation("FriendRequestRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  pairLow String @db.Uuid
  pairHigh String @db.Uuid
  state FriendRequestState @default(PENDING)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  respondedAt DateTime? @db.Timestamptz(3)
  notifications Notification[]
  // The SQL migration enforces one PENDING request per canonical pair.
  @@index([recipientId, state, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId, state, createdAt(sort: Desc), id(sort: Desc)])
  @@index([senderId, createdAt])
  @@index([pairLow, pairHigh, updatedAt(sort: Desc)])
}

model Friendship {
  id String @id @default(uuid()) @db.Uuid
  pairLow String @db.Uuid
  low User @relation("FriendshipLow", fields: [pairLow], references: [id], onDelete: Cascade)
  pairHigh String @db.Uuid
  high User @relation("FriendshipHigh", fields: [pairHigh], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([pairLow, pairHigh])
  @@index([pairLow, createdAt(sort: Desc), id(sort: Desc)])
  @@index([pairHigh, createdAt(sort: Desc), id(sort: Desc)])
}

model UserBlock {
  id String @id @default(uuid()) @db.Uuid
  blockerId String @db.Uuid
  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String @db.Uuid
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([blockedId, blockerId])
}
enum EmailJobStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}
/// Transactional outbox for asynchronous email. Provider calls never run inside domain transactions.
model EmailJob {
  id String @id @default(uuid()) @db.Uuid
  kind String @db.VarChar(40)
  dedupeKey String @unique @db.VarChar(120)
  recipientId String @db.Uuid
  recipient User @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  invitationId String? @db.Uuid
  invitation Invitation? @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  passwordResetTokenId String? @db.Uuid
  passwordResetToken PasswordResetToken? @relation(fields: [passwordResetTokenId], references: [id], onDelete: Cascade)
  status EmailJobStatus @default(PENDING)
  attempts Int @default(0)
  maxAttempts Int
  availableAt DateTime @default(now()) @db.Timestamptz(3)
  lockToken String? @db.Uuid
  lockedAt DateTime? @db.Timestamptz(3)
  lastError String? @db.VarChar(500)
  providerMessageId String? @db.VarChar(250)
  providerResponse String? @db.VarChar(500)
  skipReason String? @db.VarChar(60)
  completedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@index([status, availableAt])
}

enum GameStatus {
  ACTIVE
  FINISHED
}
enum GameColor {
  WHITE
  BLACK
}
enum GameResult {
  WHITE_WINS
  BLACK_WINS
  DRAW
  /// No result: the engine service failed (engine games only).
  ABORTED
}
/// FRIENDS games start from a room; ENGINE games seat one player against the engine service.
enum GameMode {
  FRIENDS
  ENGINE
  RANDOM
}
enum ParticipantKind {
  PLAYER
  ENGINE
}
/// How a game ended. The automatic draw rules are documented in docs/Gameplay_Milestone.md.
enum GameTermination {
  CHECKMATE
  RESIGNATION
  TIMEOUT
  TIMEOUT_VS_INSUFFICIENT_MATERIAL
  STALEMATE
  INSUFFICIENT_MATERIAL
  THREEFOLD_REPETITION
  FIFTY_MOVE_RULE
  AGREEMENT
  /// The engine service could not produce a move after bounded recovery attempts.
  ENGINE_FAILURE
}
enum GameCommandKind {
  MOVE
  RESIGN
  OFFER_DRAW
  ACCEPT_DRAW
  DECLINE_DRAW
}
/// Authoritative game. Settings are copied from the room at start and never change.
model Game {
  id String @id @default(uuid()) @db.Uuid
  /// One game per started room.
  roomId String? @unique @db.Uuid
  room Room? @relation(fields: [roomId], references: [id], onDelete: SetNull)
  mode GameMode @default(FRIENDS)
  rated Boolean @default(false)
  ratingPool RatingPool?
  ratingPolicyVersion String? @db.VarChar(24)
  status GameStatus @default(ACTIVE)
  /// Increases on every persisted change (moves, draw offers, results, clock resumption).
  revision Int @default(1)
  /// Number of accepted half-moves.
  ply Int @default(0)
  initialFen String @db.VarChar(100)
  fen String @db.VarChar(100)
  initialMs Int
  incrementMs Int
  /// Remaining time of each side when `turnStartedAt` was recorded.
  whiteRemainingMs Int
  blackRemainingMs Int
  /// Server time the side to move started thinking; null once finished.
  turnStartedAt DateTime? @db.Timestamptz(3)
  drawOfferBy GameColor?
  /// The player whose draw offer was declined, until the next move.
  drawDeclinedBy GameColor?
  result GameResult?
  termination GameTermination?
  pgn String?
  startedAt DateTime @db.Timestamptz(3)
  endedAt DateTime? @db.Timestamptz(3)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  participants GameParticipant[]
  moves GameMove[]
  commands GameCommand[]
  matchmakingAssignments MatchmakingSearch[]
  ratingSettlement RatingSettlement?
  @@index([status])
  @@index([status, endedAt(sort: Desc), id(sort: Desc)])
  @@index([mode, status])
}

/// One durable search/assignment per account. Revision survives new searches.
model MatchmakingSearch {
  userId String @id @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  searchId String @default(uuid()) @db.Uuid
  revision Int @default(1)
  state String @default("idle") @db.VarChar(16)
  rated Boolean @default(false)
  ratingPool RatingPool?
  initialMs Int @default(600000)
  incrementMs Int @default(0)
  queuedAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @default(now()) @db.Timestamptz(3)
  pairId String? @db.Uuid
  ready Boolean @default(false)
  gameId String? @db.Uuid
  game Game? @relation(fields: [gameId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  reason String? @db.VarChar(32)
  // Match the existing SQL migration's PostgreSQL-truncated index name.
  @@index([state, initialMs, incrementMs, queuedAt, userId], map: "MatchmakingSearch_state_initialMs_incrementMs_queuedAt_userId_i")
  @@index([pairId])
}
/// A seat: a registered account, or the engine service (never a fake user).
model GameParticipant {
  gameId String @db.Uuid
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  color GameColor
  kind ParticipantKind @default(PLAYER)
  /// Completed games are history: an account with games cannot be deleted silently. Null for the engine.
  userId String? @db.Uuid
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  /// Name the engine service reported when the game was created. Null for players.
  engineName String? @db.VarChar(64)
  ratingBefore Int?
  ratingGamesBefore Int?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  moves GameMove[]
  ratingChange RatingChange?
  @@id([gameId, color])
  @@unique([gameId, userId])
  @@index([userId, createdAt(sort: Desc)])
}
/// Immutable accepted move with its resulting position and clock snapshot.
model GameMove {
  gameId String @db.Uuid
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  ply Int
  color GameColor
  participant GameParticipant @relation(fields: [gameId, color], references: [gameId, color], onDelete: Cascade)
  /// The player who moved; null for engine moves.
  actorId String? @db.Uuid
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  /// Player moves: the client's request id. Engine moves: derived from game and revision.
  requestId String @db.Uuid
  /// Coordinate notation, e.g. e2e4 or e7e8q (UCI).
  uci String @db.VarChar(5)
  san String @db.VarChar(12)
  /// Captured piece letter (p, n, b, r, q), if any.
  captured String? @db.Char(1)
  fenAfter String @db.VarChar(100)
  playedAt DateTime @db.Timestamptz(3)
  /// Time the mover used, before increment.
  elapsedMs Int
  whiteRemainingMs Int
  blackRemainingMs Int
  @@id([gameId, ply])
}
/// Ledger of applied commands; retries with the same request id are answered from it.
model GameCommand {
  gameId String @db.Uuid
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  actorId String @db.Uuid
  actor User @relation(fields: [actorId], references: [id], onDelete: Restrict)
  requestId String @db.Uuid
  kind GameCommandKind
  /// Canonical command content; a retry must match it exactly.
  fingerprint String @db.VarChar(80)
  /// Game revision after the command was applied.
  revision Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([gameId, actorId, requestId])
}

enum RatingPool {
  bullet
  blitz
  rapid
}

model PlayerRating {
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  pool RatingPool
  rating Int @default(1200)
  peakRating Int @default(1200)
  games Int @default(0)
  wins Int @default(0)
  draws Int @default(0)
  losses Int @default(0)
  revision Int @default(0)
  /// Reserved for account moderation; no player-writable endpoint.
  leaderboardEligible Boolean @default(true)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  @@id([userId, pool])
  @@index([pool, leaderboardEligible, rating(sort: Desc), userId])
}

model RatingSettlement {
  gameId String @id @db.Uuid
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)
  policyVersion String @db.VarChar(24)
  kFactor Int
  ratingFloor Int
  expectedWhite Float
  scoreWhite Float
  roundedDeltaWhite Int
  appliedDeltaWhite Int
  settledAt DateTime @default(now()) @db.Timestamptz(3)
  changes RatingChange[]
}

model RatingChange {
  gameId String @db.Uuid
  settlement RatingSettlement @relation(fields: [gameId], references: [gameId], onDelete: Cascade)
  userId String @db.Uuid
  user User @relation("RatingPlayer", fields: [userId], references: [id], onDelete: Restrict)
  participant GameParticipant @relation(fields: [gameId, userId], references: [gameId, userId], onDelete: Cascade)
  opponentId String @db.Uuid
  opponent User @relation("RatingOpponent", fields: [opponentId], references: [id], onDelete: Restrict)
  pool RatingPool
  before Int
  delta Int
  after Int
  score Float
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@id([gameId, userId])
  @@index([userId, pool, createdAt(sort: Desc), gameId(sort: Desc)])
}
