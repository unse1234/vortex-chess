NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Create a dedicated database/user; replace all placeholders. Do not commit .env.
DATABASE_URL=postgresql://vortix_app:replace_with_local_password@localhost:5432/vortix_chess?schema=public
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=generate_a_random_signing_secret_before_starting
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_TTL_SECONDS=300
SESSION_TTL_HOURS=24
REMEMBER_SESSION_DAYS=30
# Keep 0 for direct access. Set only to the known number of trusted reverse proxies.
TRUST_PROXY_HOPS=0
# Frontend base URL used in emailed invitation and password reset links (defaults to the first
# CORS origin). Never derived from request headers. HTTPS is required in production.
APP_PUBLIC_URL=http://localhost:3000
ROOM_TTL_MINUTES=120
INVITATION_TTL_MINUTES=30
MAX_ACTIVE_ROOMS_PER_USER=5
# Background expiry sweep; 0 disables it (every operation still enforces expiry).
EXPIRY_SWEEP_INTERVAL_SECONDS=30
REALTIME_SESSION_CHECK_SECONDS=60
REALTIME_MAX_SOCKETS_PER_USER=10
# Friends: new requests per rolling hour and pair-wide resend cooldown after terminal requests.
FRIEND_REQUEST_MAX_PER_HOUR=30
FRIEND_REQUEST_COOLDOWN_SECONDS=300
# Last authenticated socket disconnect grace. Presence supports one backend instance.
PRESENCE_DISCONNECT_GRACE_MS=3000
# Password recovery: link lifetime, minimum gap between reset emails per account, and hourly cap.
# Requests inside the limits get the same public response; they never lock the account.
PASSWORD_RESET_TTL_MINUTES=30
PASSWORD_RESET_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_PER_HOUR=5
# disabled = invitation and password reset emails stay queued as PENDING outbox jobs; smtp = send via your provider.
MAIL_TRANSPORT=disabled
# Required when MAIL_TRANSPORT=smtp. Keep credentials in the ignored .env only.
# MAIL_FROM=Vortex Chess <noreply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# 0 disables the in-process worker; jobs remain queued.
MAIL_WORKER_INTERVAL_SECONDS=10
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_BASE_SECONDS=30
MAIL_LEASE_SECONDS=120
# Engine games: the NestJS backend calls the engine service (FastAPI, HTTP/JSON; UCI internally).
# The browser never calls it. Leave unset to disable engine games. HTTPS is required in production.
# Set your own compatible service URL to enable engine play; omit to keep it disabled.
# ENGINE_BASE_URL=https://engine.example.invalid
# movetime requested per engine move (10-30000); shortened when the engine's own clock requires it.
ENGINE_SEARCH_MOVETIME_MS=200
# Clock kept back for HTTP travel/service queueing, and for committing the move. Measured
# round trip from a local backend: p50 ~0.6 s, p95 ~0.75 s (see docs/Engine_Gameplay_Milestone.md).
ENGINE_TRANSPORT_RESERVE_MS=1500
ENGINE_COMMIT_RESERVE_MS=150
# Hard limit per analyze request (must cover movetime + transport reserve); health check limit.
ENGINE_REQUEST_TIMEOUT_MS=10000
ENGINE_HEALTH_TIMEOUT_MS=3000
# Bounded upstream use: searches in flight, waiting searches, and active engine games (admission).
ENGINE_MAX_CONCURRENT_SEARCHES=1
ENGINE_MAX_QUEUED_SEARCHES=16
ENGINE_MAX_ACTIVE_GAMES=4
# Attempts per engine move (busy/unavailable/connection failures only) and retry backoff base.
ENGINE_MAX_ATTEMPTS=3
ENGINE_RETRY_BASE_MS=300
# After an aborted request the slot stays reserved this long: the remote search may still run.
ENGINE_ABORT_QUARANTINE_MS=2000
# Periodic repair of missed engine turns; 0 disables (commits and startup still schedule).
ENGINE_RECOVERY_INTERVAL_SECONDS=5
MATCHMAKING_ENABLED=true
RATINGS_ENABLED=true
# seconds:maximum-Elo-difference; both players' windows must allow pairing.
# Unrestricted within the same exact control/pool after the last threshold.
MATCHMAKING_RATING_WINDOWS=15:100,30:200,60:400
