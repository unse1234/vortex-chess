NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Create a dedicated database/user; replace all placeholders. Do not commit .env.
DATABASE_URL=postgresql://postgres:123Unse@localhost:5432/vortix_chess?schema=public
# Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=8f214db13437da8e2a393b20049d24de5dadc8e2cce099a8647eab54e66b3ba8
CORS_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax
ACCESS_TOKEN_TTL_SECONDS=300
SESSION_TTL_HOURS=24
REMEMBER_SESSION_DAYS=30
# Keep 0 for direct access. Set only to the known number of trusted reverse proxies.
TRUST_PROXY_HOPS=0
# Frontend base URL used in emailed invitation links (defaults to the first CORS origin).
APP_PUBLIC_URL=http://localhost:3000
ROOM_TTL_MINUTES=120
INVITATION_TTL_MINUTES=30
MAX_ACTIVE_ROOMS_PER_USER=5
# Background expiry sweep; 0 disables it (every operation still enforces expiry).
EXPIRY_SWEEP_INTERVAL_SECONDS=30
REALTIME_SESSION_CHECK_SECONDS=60
REALTIME_MAX_SOCKETS_PER_USER=10
# disabled = invitation emails stay queued as PENDING outbox jobs; smtp = send via your provider.
MAIL_TRANSPORT=disabled
# Required when MAIL_TRANSPORT=smtp. Keep credentials in the ignored .env only.
# MAIL_FROM=Vortex Chess <noreply@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# 0 disables the in-process worker; jobs remain queued.
MAIL_WORKER_INTERVAL_SECONDS=10
MAIL_MAX_ATTEMPTS=5
MAIL_RETRY_BASE_SECONDS=30
MAIL_LEASE_SECONDS=120
