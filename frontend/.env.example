# Real NestJS API; use localhost for both apps locally.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api
# API mode is the default. Enable only for the standalone MSW demo.
NEXT_PUBLIC_API_MOCKING=disabled
# Friends and blocked-account settings require backend migration 202610290001_social.
# They use the same authenticated API/realtime connection; demo mode keeps management disabled.
# Optional: Socket.IO origin if it differs from the API origin (path is <API path>/socket.io).
# NEXT_PUBLIC_REALTIME_URL=http://localhost:3001
